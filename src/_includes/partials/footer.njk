{%- from "partials/icons.njk" import linkedin, download -%}

{#- The designed "Want to connect?" section (Figma 2227:8059), with the contact
    form removed. The design's two buttons map across: the accent "Request call
    back" slot becomes Download CV, and the LinkedIn-blue button stays as-is. -#}
<footer class="footer">
  <div class="container">
    <div class="section__head">
      <h2 class="section-title">Want to connect?</h2>
    </div>
    <div class="footer__card">
      <h3>Let&rsquo;s talk</h3>
      <p>
        I&rsquo;m open to conversations about product and service design work — especially
        where AI changes what a team can build.
        {% if site.cvReady %}The quickest way to reach me is LinkedIn, and my CV has the
        full detail plus my email.{% else %}The quickest way to reach me is LinkedIn.{% endif %}
      </p>
      <div class="btn-row">
        {% if site.cvReady %}
        <a class="btn btn--accent" href="{{ site.cv }}" download>
          {{ download() }} Download CV
        </a>
        {% endif %}
        <a class="btn btn--linkedin" href="{{ site.linkedin }}"
           target="_blank" rel="noopener noreferrer">
          {{ linkedin() }} Message me on LinkedIn
        </a>
      </div>
    </div>
    <div class="footer__meta">
      <p>&copy; {{ site.name }}</p>
      <p>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        {% if site.cvReady %}&nbsp;·&nbsp;<a href="{{ site.cv }}" download>CV</a>{% endif %}
      </p>
    </div>
  </div>
</footer>
