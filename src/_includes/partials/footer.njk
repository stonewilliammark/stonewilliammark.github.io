{#- The designed "Want to connect?" section, with the contact form removed.
    Two routes out: LinkedIn for a conversation, the CV for the detail. -#}
<footer class="footer">
  <div class="container">
    <h2 class="footer__title">Want to connect?</h2>
    <div class="footer__card">
      <h3>Let&rsquo;s talk</h3>
      <p>
        I&rsquo;m open to conversations about product and service design work — especially
        where AI changes what a team can build. The quickest way to reach me is LinkedIn,
        and my CV has the full detail plus my email.
      </p>
      <div class="btn-row">
        <a class="btn btn--on-dark" href="{{ site.linkedin }}"
           target="_blank" rel="noopener noreferrer">Message me on LinkedIn</a>
        <a class="btn btn--ghost-dark" href="{{ site.cv }}" download>Download CV (PDF)</a>
      </div>
    </div>
    <div class="footer__meta">
      <p>&copy; {{ site.name }}</p>
      <p>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        &nbsp;·&nbsp;
        <a href="{{ site.cv }}" download>CV</a>
      </p>
    </div>
  </div>
</footer>
