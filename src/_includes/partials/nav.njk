{%- from "partials/icons.njk" import linkedin -%}

{#- A floating translucent pill, 64px tall and 24px from the top of the page
    (Figma 2230:13515 / 2230:13516) — not a full-width bar. The wrapper is
    pointer-events:none so the empty space either side of the pill never
    intercepts clicks on the content beneath it.

    "Skills" is intentionally absent: the mocks include the tab but no such page
    was ever designed, so it would ship as a dead link (decided 2026-08-10). -#}
<header class="nav">
  <div class="container">
    <nav class="nav__pill" aria-label="Primary">
      <div class="nav__group">
        <a class="nav__brand" href="/">William Stone</a>
        {#- "page" on /work/ itself, "true" on a case study — which is inside the
            Work section, so the nav should show where you are rather than
            nothing at all, which is what it did before. -#}
        <a class="nav__link" href="/work/"
           {% if page.url == "/work/" %}aria-current="page"
           {% elif page.url.startsWith("/work/") %}aria-current="true"{% endif %}>Work</a>
        <a class="nav__link" href="/#about">About</a>
      </div>
      {#- Dark pill with the LinkedIn glyph. The blue stroke in the Figma frame was
          accidental and is not applied. External, so noopener/noreferrer. -#}
      <a class="btn btn--primary" href="{{ site.linkedin }}"
         target="_blank" rel="noopener noreferrer">
        {{ linkedin() }} Let&rsquo;s talk
      </a>
    </nav>
  </div>
</header>
