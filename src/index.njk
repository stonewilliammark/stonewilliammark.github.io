---
layout: base.njk
permalink: /
---
{% from "partials/work-card.njk" import card %}
{% from "partials/icons.njk" import chevron %}
{%- set selected = collections.caseStudies -%}

<section class="container hero">
  <p class="eyebrow">{{ site.eyebrow }}</p>
  <h1 class="h1">{{ site.headline }}</h1>
  <p class="deck">{{ site.intro }}</p>
  <div class="btn-row">
    <a class="btn btn--primary" href="/work/">View work</a>
    {#- The CV button only renders once the PDF is actually in the repo. Set
        site.cvReady to true in _data/site.json when it lands — better than
        shipping a CTA that 404s. -#}
    {% if site.cvReady %}
    <a class="btn btn--secondary" href="{{ site.cv }}" download>Download CV</a>
    {% else %}
    <a class="btn btn--secondary" href="{{ site.linkedin }}"
       target="_blank" rel="noopener noreferrer">Let&rsquo;s talk</a>
    {% endif %}
  </div>
</section>

<section class="section" aria-labelledby="selected-work-heading">
  <div class="container">
    <div class="section__head">
      <h2 class="section-title" id="selected-work-heading">Selected work</h2>
      <a class="pill-link" href="/work/">View all work {{ chevron() }}</a>
    </div>
  </div>

  {#- Carousel: native scroll-snap does the work, so it stays interruptible and
      velocity-aware without any spring physics of our own. The arrows and dots
      are progressive enhancement — with JS off this is still a usable,
      swipeable, fully readable list.

      The track deliberately sits OUTSIDE .container so the next card can peek
      into the page margin, matching the design. -#}
  <div class="carousel" data-carousel>
    <div class="carousel__track" data-carousel-track tabindex="0"
         role="group" aria-label="Selected case studies">
      {%- for item in selected %}
      <div class="carousel__slide" data-carousel-slide>
        {{ card(item, "h3", "read") }}
      </div>
      {%- endfor %}
    </div>
    <div class="container">
      <div class="carousel__controls" hidden data-carousel-controls>
        <ul class="carousel__dots" data-carousel-dots></ul>
        <div class="carousel__arrows">
          <button class="carousel__arrow" type="button" data-carousel-prev
                  aria-label="Previous case study">{{ chevron("left") }}</button>
          <button class="carousel__arrow" type="button" data-carousel-next
                  aria-label="Next case study">{{ chevron() }}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section--surface" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="section__head">
      <h2 class="section-title" id="about-heading">About me</h2>
    </div>
    <div class="about">
      <div class="card__body">
        <h3 class="card__title">Hey it&rsquo;s Will, thanks for popping by</h3>
        <p class="card__deck">
          I find my joy in creating interactions that feel natural and meaningful.
          It&rsquo;s incredibly fulfilling to see someone&rsquo;s eyes light up in that
          &ldquo;aha&rdquo; moment when they connect with my work. When I&rsquo;m not
          creating experiences for others, I&rsquo;m capturing moments with my camera
          or unwinding in the waves.
        </p>
        <div class="card__cta">
          <a class="btn btn--primary" href="{{ site.linkedin }}"
             target="_blank" rel="noopener noreferrer">Let&rsquo;s talk</a>
        </div>
      </div>
      <div class="about__media">
        <img class="about__portrait" src="/img/about/portrait.jpg"
             alt="Portrait of {{ site.name }}">
      </div>
    </div>
  </div>
</section>
